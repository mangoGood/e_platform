# 电商平台环境变量配置示例
# 复制为 .env 并填入实际值后使用

# JWT 密钥（必须 >= 64 字符，建议使用随机字符串）
# 生成方式: openssl rand -base64 64
JWT_SECRET=please-generate-a-random-secret-key-at-least-64-chars-long-here

# 数据库
DB_USERNAME=root
DB_PASSWORD=root

# 内部服务调用令牌
INTERNAL_TOKEN=ePlatformInternalSecret2026

# Nacos 服务注册发现（可选，默认禁用）
# 启用需先运行 Nacos Server，然后设置 NACOS_ENABLED=true
NACOS_ENABLED=false
NACOS_ADDR=localhost:8848
NACOS_NAMESPACE=public
