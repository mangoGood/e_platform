# 电商平台环境变量配置示例
# 复制为 .env 并填入实际值后使用；也可直接运行 ./start.sh 自动生成 .env（随机密钥）
# 注意：.env 已被 .gitignore 忽略，请勿提交真实密钥

# =============================================================================
# 安全密钥
# =============================================================================

# JWT 签发密钥（必须 >= 64 字符）
# application.yml 中 jwt.secret 无默认值，缺失会导致服务启动失败
# 生成方式: openssl rand -base64 48
JWT_SECRET=please-generate-a-random-secret-key-at-least-64-chars-long-here

# 网关 -> 内部服务的 HMAC-SHA256 签名密钥（必须 >= 32 字符）
# 对应配置键 gateway.sign.secret；网关签名、各服务验签共用同一份密钥
# 生成方式: openssl rand -base64 32
GATEWAY_SIGN_SECRET=please-generate-a-random-gateway-sign-secret-at-least-32-chars

# 内部服务调用令牌（服务间直连时的简单口令，>= 24 字符）
# 生成方式: openssl rand -base64 24
INTERNAL_TOKEN=ePlatformInternalSecret2026

# =============================================================================
# 数据库
# =============================================================================
DB_USERNAME=root
DB_PASSWORD=root

# =============================================================================
# 抢购排队（网关侧令牌桶排队，对应配置键 queue.*）
# 演示排队效果：把 QUEUE_PERMITS 设为 1，例如 QUEUE_PERMITS=1 ./start.sh
# =============================================================================

# 排队总开关。设为 false 时网关全量放行（由 NoopQueueService 兜底），
# 适合本地调试功能逻辑时临时绕开排队；线上请保持 true
QUEUE_ENABLED=true

# 同时可进入下单流程的并发名额数（令牌总数）
QUEUE_PERMITS=50

# 排队队列最大长度，超出直接返回 503「当前抢购人数过多」
QUEUE_MAX_LENGTH=500

# 单个用户最长排队等待秒数，超时返回 408「等待超时，请重新提交」
QUEUE_WAIT_TIMEOUT=60

# 获得名额后票据（X-Queue-Token）的有效秒数，过期自动释放名额
QUEUE_PERMIT_TTL=30

# 建议客户端轮询 GET /api/queue/status 的间隔秒数
# 随 202 响应体的 data.pollInterval 下发，前端/Android 无需硬编码；
# 调小会加快队列消化但放大 Redis QPS，调大则相反
QUEUE_POLL_INTERVAL=2

# =============================================================================
# Nacos 服务注册发现（可选，默认禁用）
# 启用需先运行 Nacos Server，然后设置 NACOS_ENABLED=true
# =============================================================================
NACOS_ENABLED=false
NACOS_ADDR=localhost:8848
NACOS_NAMESPACE=public

# =============================================================================
# 构建工具链说明（注意：以下两项由 scripts/env.sh 读取，必须 export 到 shell 环境，
# 写在本文件里不生效 —— .env 是在 env.sh 之后才被 start.sh 载入的）
#
# 全栈统一使用 JDK 21：Spring Boot 2.7.18 不支持 JDK 24，根 pom <release>17 排除 JDK 8，
# Android AGP 8.2.2 + Gradle 8.5 最高支持 JDK 21 —— 21 是唯一交集。
#
#   export JAVA_HOME_21=/Users/finn/Library/Java/JavaVirtualMachines/ms-21.0.9/Contents/Home
#   export MAVEN_BIN=/Users/finn/Maven/apache-maven-3.9.9/bin/mvn
# =============================================================================
